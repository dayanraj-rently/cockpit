# Copy this file to .env and fill in your values. Never commit .env.

# Jira base URL, email, API token, and JQL are all configured per-user from
# the Settings screen in the app (token encrypted at rest) instead of here.

# PostgreSQL connection string. If you're running the docker-compose "db"
# service, this points at its exposed host port; adjust user/password/db
# name to match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB in the repo
# root's .env used by docker-compose.
DATABASE_URL=postgres://cockpit:changeme@localhost:5432/cockpit

# 32-byte key (base64) used to encrypt the Jira API token at rest.
# Generate with `npm run generate-key` from server/. Losing/changing this
# makes previously saved tokens undecryptable.
ENCRYPTION_KEY=

PORT=8787

# Where the React app is served from — used to redirect the browser back
# here after the Google OAuth consent screen. Defaults to the Vite dev
# server if unset.
CLIENT_URL=http://localhost:5173

# Google Calendar OAuth (optional — only needed for the "Google Calendar"
# tab in Settings). Create these at https://console.cloud.google.com:
# 1. New project → enable the "Google Calendar API"
# 2. OAuth consent screen → External → Testing → add yourself as a test user
# 3. Credentials → Create OAuth client ID → Web application
#    → Authorized redirect URI: http://localhost:8787/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/google/callback
