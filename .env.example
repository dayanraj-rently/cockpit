# Copy this file to .env (repo root) and fill in your values before running
# `docker compose up`. Never commit .env. This is separate from
# server/.env.example, which is for running the server directly (outside
# Docker) during local development.

# Postgres credentials — used by both the "db" service (to initialize the
# database) and the "app" service (to build its DATABASE_URL).
POSTGRES_USER=cockpit
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cockpit

# 32-byte key (base64) used to encrypt the Jira API token and Google OAuth
# tokens at rest. Generate one with `npm run generate-key` from server/
# (works the same with or without Docker running). Losing/changing this
# makes previously saved secrets undecryptable.
ENCRYPTION_KEY=

# Where the browser reaches the app — used to redirect back here after the
# Google OAuth consent screen. In the production-style container, the
# client is served by the same app container as the API, so this is the
# app's own external URL/port, not a separate client origin.
CLIENT_URL=http://localhost:8787

# Google Calendar OAuth (optional — only needed for the "Google Calendar"
# tab in Settings). Create these at https://console.cloud.google.com — see
# server/.env.example for the exact steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/google/callback
